# URL da API do seu Supabase (o domínio que aponta pro Kong)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Redis (fila de debounce via BullMQ) — a URL de conexão interna que
# pegamos no Easypanel (algo como redis://default:SENHA@agente-de-ia_redis:6379)
REDIS_URL=""

# Tempo padrão (em segundos) de espera para agrupar mensagens fracionadas.
# Pode ser sobrescrito por empresa via a tabela configuracoes_agente.
DEBOUNCE_SECONDS_DEFAULT=7

# Microsserviço Python do classificador de intenções
CLASSIFICADOR_URL=""
LIMIAR_CONFIANCA_DEFAULT=0.6

WEBHOOK_SECRET=""
PORT=3000

EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""

LINK_POLITICA_PRIVACIDADE=""
HORAS_INATIVIDADE_CHAMADO=24

ANTHROPIC_API_KEY=""

SUPABASE_ANON_KEY=<anon key>
PAINEL_ORIGEM=
NODE_ENV=production

URL_PAINEL=
SMTP_HOST=
SMTP_PORTA=
SMTP_USUARIO=
SMTP_SENHA=
